rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can only read and write their own document in the users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public read access for government welfare schemes
    match /schemes/{schemeId} {
      allow read: if true;
    }
    
    // Public read access for government competitive examinations
    match /exams/{examId} {
      allow read: if true;
    }
  }
}
